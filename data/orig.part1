vel\"><div data-floor-level=\"\" class=\"type-mobile_floor-level-txt\">000</div></div><button type=\"button\" data-floor-up=\"\" aria-label=\"Floor up\" class=\"type-mobile_btn\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"64\" height=\"30\" viewBox=\"0 0 64 30\" fill=\"none\" class=\"type-mobile_btn-arrow\"><path d=\"M39.0741 11.8004C39.2994 11.9601 39.3528 12.2724 39.1932 12.4977L33.7479 20.1842C33.6542 20.3166 33.5019 20.3952 33.3397 20.3952C33.1775 20.3952 33.0252 20.3166 32.9315 20.1842L27.4862 12.4977C27.3266 12.2724 27.38 11.9601 27.6053 11.8004C27.8306 11.6409 28.143 11.6943 28.3026 11.9196L33.3397 19.029L38.3768 11.9196C38.5364 11.6943 38.8487 11.6409 39.0741 11.8004Z\" fill=\"#151515\"></path></svg></button></div><button data-floor-enter=\"\" type=\"button\" aria-label=\"Enter Floor\" class=\"type-mobile_enter-btn is--disabled\">ENTER UNIT</button></div></div></section><div class=\"hide\"><div data-unit-status-list=\"a\" class=\"w-dyn-list\"><div role=\"list\" class=\"w-dyn-items\"><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1001\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1002\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1003\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1004\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1005\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1006\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1007\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1008\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1206\"></div></div><div role=\"lis