></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1406\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1405\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1404\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1403\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1402\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1401\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1302\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1301\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1206\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1008\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1007\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1006\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1005\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1004\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1003\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1002\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1001\"></div></div></div></div></div>"},"/floors/17":{"title":"17th Floor Plan | Journalist House Tel Aviv","bodyClass":"","embeds":[{"c":"global-css w-embed","h":"<style>\n  :root {\n    --font-from: 10;\n    --font-to: 10;\n    --vw-from: calc(1920 / 100);\n    --vw-to: calc(2849 / 100);\n    --coefficient: calc((var(--font-to) - var(--font-from)) / (var(--vw-to) - var(--vw-from)));\n    --base: calc((var(--font-from) - var(--vw-from) * var(--coefficient)) / 16);\n  }\n\n  html {\n    font-size: calc(var(--base) * 1rem + var(--coefficient) * 1vw);\n  }\n\n  @media screen and (max-width: 1920px) {\n    :root {\n      --font-from: 6;\n      --font-to: 10;\n      --vw-from: calc(991 / 100);\n      --vw-to: calc(1920 / 100);\n    }\n  }\n\n  @media screen and (max-width: 991px) {\n    :root {\n      --font-from: 10;\n      --font-to: 10;\n      --vw-from: calc(1 / 100);\n      --vw-to: calc(991 / 100);\n    }\n  }\n  @media screen and (min-width: 992px) {\n    .chapter-tile:hover .chapter-link-arrow {\n      transform: translate(0rem, 0px);\n    }\n  }\n</style>\n\n<style>\n  /* Remove gray tap highlight on iOS */\n  a,\n  button,\n  input,\n  textarea,\n  .contact-us_x-wrapper {\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  a,\n  button {\n    outline: 0;\n  }\n\n  /* Make text look crisper and more legible in all browsers */\n  body {\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n    font-smoothing: antialiased;\n  }\n\n  html.lenis,\n  html.lenis body {\n    height: auto;\n  }\n  .lenis.lenis-smooth {\n    scroll-behavior: auto !important;\n  }\n  .lenis.lenis-smooth [data-lenis-prevent] {\n    overscroll-behavior: contain;\n  }\n  .lenis.lenis-stopped {\n    overflow: hidden;\n  }\n  .lenis.lenis-smooth iframe {\n    pointer-events: none;\n  }\n  html.is-preloading {\n    overflow: hidden;\n  }\n</style>\n<style>\n  .wf-design-mode .loader {\n    display: none;\n  }\n  /* Add auto overflow in webflow to make editing easier */\n  .wf-design-mode [data-horizontal-scroll-wrap] {\n    overflow: auto;\n  }\n  [data-load-reset] {\n    opacity: 0;\n  }\n\n  .chapter-tile__thumb-wrapper:hover .chapter-tile__thumb {\n    transform: scale(1.05);\n  }\n\n  /* .chapter-tile:hover .chapter-link-arrow {\n    transform: translate(0rem, 0px);\n  } */\n  .chapter-tile:hover .chapter-link-hovered {\n    opacity: 1;\n  }\n</style>\n\n<style>\n  /* Chapter menu — always legible on any background.\n   White ink + difference blend = the menu paints as the inverse of whatever is\n   behind it, so it stays visible over any colour or full-bleed image. */\n  .chapter-menu-c {\n    mix-blend-mode: difference;\n    background-color: transparent; /* any solid bg here would blend and kill the effect */\n  }\n  /* Ink must be white so 'difference' inverts the backdrop into a contrasting colour. */\n  .chapter-menu-c {\n    color: #fff;\n  } /* label text */\n  .chapter-menu-c .chapter-track {\n    background-color: rgba(255, 255, 255, 0.35);\n  } /* faint line */\n  .chapter-menu-c .chapter-track-fake {\n    background-color: rgba(255, 255, 255, 0.35);\n  } /* faint line */\n\n  .chapter-menu-c .chapter-track-fake.is--journy-2 {\n    background-color: #fff;\n  } /* faint line */\n  .chapter-menu-c .chapter-fill {\n    background-color: #fff;\n  } /* progress fill */\n\n  /* Scroll-lock while the Inquire modal is open (Lenis is stopped; this kills native fallback scroll) */\n  html.is-inquire-open {\n    overflow: hidden;\n    scrollbar-gutter: stable;\n  }\n  /* Modal hidden until JS takes over */\n  [mt-el='inquire-modal'] {\n    display: none;\n  }\n\n  #language-bar,\n  .enable-bottomlinks-feedback,\n  .enable-toolbar-links-section.enable-toolbar-link-powered-by,\n  .keyboard-shorcut {\n    display: none !important;\n  }\n</style>\n\n<!-- Mobile Sliders thumbs and scrollbars -->\n<style>\n  @media (max-width: 991px) {\n    [data-scrollbar] {\n      overflow-x: auto;\n      overflow-y: hidden;\n      scrollbar-width: none;\n    }\n    [data-scrollbar]::-webkit-scrollbar {\n      display: none;\n    }\n    [data-scrollbar] > * {\n      flex-shrink: 0;\n    }\n  }\n\n  /* Override per slider by setting these variables on the slider's parent */\n  [data-scrollbar-track] {\n    position: relative;\n    width: var(--scrollbar-track-width, calc(100% - 4rem));\n    height: 3px;\n    margin: var(--scrollbar-gap, 24px) auto 0;\n  }\n  [data-scrollbar-track]::before {\n    content: '';\n    position: absolute;\n    left: 0;\n    right: 0;\n    top: 1px;\n    height: 1px;\n    background: #ddd8d7;\n  }\n  [data-scrollbar-thumb] {\n    position: relative;\n    width: 40px;\n    height: 100%;\n    background: #000;\n    touch-action: none;\n  }\n\n  @media (min-width: 992px) {\n    [data-scrollbar-track] {\n      display: none;\n    }\n  }\n</style>"},{"c":"page-styles w-embed","h":"<style>\n  /* See-the-Residences — global sequence gallery */\n\n  /* Take over the sliders: stack every slide in one grid cell + kill Webflow's\n   slide transforms; the bundle owns opacity for the crossfade. */\n  .gallery_slider.is--managed .gallery_mask {\n    display: grid;\n  }\n  .gallery_slider.is--managed .gallery_slide {\n    grid-area: 1 / 1;\n    transform: none !important;\n    opacity: 0;\n  }\n  .gallery_slider.is--managed .gallery_slide.is--active {\n    opacity: 1;\n  }\n\n  /* Hide the native per-slider arrows + dots — one global control drives them. */\n  .gallery_slider .w-slider-arrow-left,\n  .gallery_slider .w-slider-arrow-right,\n  .gallery_slider .w-slider-nav {\n    display: none !important;\n  }\n\n  /* Global arrows: disabled look at the sequence ends (JS toggles data-disabled). */\n  [data-gallery-arrow][data-disabled] {\n    opacity: 0.35;\n    pointer-events: none;\n  }\n</style>\n<style>\n  .mt-unit-details .unit-status {\n    position: static; /* kill any leftover absolute positioning */\n    display: block;\n    margin-bottom: 0rem; /* space between it and APARTMENT AREA — tune to taste */\n  }\n  .mt-unit-details {\n    margin-top: 2rem;\n  }\n  .is--unavailable path {\n    fill: black;\n  }\n\n  /* positioning context for the out-of-flow sub-line */\n  .the-building_hovered-text {\n    position: relative;\n  }\n\n  .unit-status {\n    position: absolute;\n    left: 0; /* align to the UNIT / number left edge */\n    top: 90%; /* below the label, no added height */\n    margin-top: 0.25em;\n    font-size: 0.55em; /* smaller than the unit number */\n    letter-spacing: normal; /* was 0.06em → too wide */\n    text-transform: uppercase;\n    text-align: left;\n    white-space: nowrap;\n    opacity: 0.65;\n  }\n</style>\n<style>\n  /*MOBILE  */\n  .type-mobile_floor-level-txt, [unit-data-wrap] {\n    opacity: 0;\n    visibility: hidden;\n  }\n</style>"},{"c":"navbar-size-shrink-code w-embed","h":"<style>\n  @media (min-width: 992px) {\n    .chapter-tile__thumb-wrapper {\n      aspect-ratio: 277 / 291;\n      min-height: 0;\n      max-height: 100%;\n      overflow: hidden;\n    }\n\n    .chapter-tile__thumb {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      display: block;\n    }\n\n    .chapter-tile {\n      min-height: 0;\n      display: flex;\n      flex-direction: column;\n    }\n\n    .chapter-bottom_wrap {\n      flex: 0 0 auto;\n    }\n\n    .chapter-menu__grid {\n      flex: 0 1 auto;\n      min-height: 0;\n      align-content: center;\n    }\n  }\n</style>"},{"c":"hamburger_embed w-embed","h":"<style>\n  @media (min-width: 992px) {\n    .hamburger_5_wrap {\n      --thickness: 0.2rem;\n      --gap: 1rem;\n      --rotate: 35;\n      --width: 100%;\n    }\n    .w--open .hamburger_5_line {\n      transform: scaleX(0);\n    }\n    .w--open .hamburger_5_line:first-child {\n      transform: translateY(calc(var(--thickness) + var(--gap))) rotate(calc(var(--rotate) * -1deg));\n    }\n    .w--open .hamburger_5_line:last-child {\n      transform: translateY(calc(var(--thickness) * -1 + var(--gap) * -1)) rotate(calc(var(--rotate) * 1deg));\n    }\n  }\n\n    @media (max-width: 991px) {\n    .hamburger_5_wrap {\n      --thickness: 0.1rem;\n      --gap: 0.5rem;\n      --rotate: 45;\n      --width: 100%;\n    }\n    .w--open .hamburger_5_line {\n      transform: scaleX(0);\n    }\n    .w--open .hamburger_5_line:first-child {\n      transform: translateY(calc(var(--thickness) + var(--gap))) rotate(calc(var(--rotate) * -1deg));\n    }\n    .w--open .hamburger_5_line:last-child {\n      transform: translateY(calc(var(--thickness) * -1 + var(--gap) * -1)) rotate(calc(var(--rotate) * 1deg));\n    }\n  }\n</style>"}],"scripts":["https://jurnalist-house-2026.vercel.app/pages/floors.js"],"inline":["\n  // Hebrew locale (/he, dir=\"rtl\") loads the Hebrew build; every other page loads English.\n  document.write('<script defer src=\"https://jurnalist-house-2026.vercel.app/' + (document.documentElement.dir === \"rtl\" ? \"he/\" : \"\") + 'global.js\"><\\/script>');\n"],"main":"<section class=\"section_plans-hero\"><a mt-el=\"back-history\" href=\"#\" class=\"back-btn w-inline-block\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"11\" height=\"16\" viewBox=\"0 0 11 16\" fill=\"none\" class=\"back-btn-arrow\"><path d=\"M10.3438 0.580013L1.19082 7.99704L10.3438 15.4141\" stroke=\"#151515\" stroke-width=\"1.5\"></path></svg><div class=\"back-btn-text\">BACK</div></a><div data-pin-length=\"1.5\" data-horizontal-scroll-panel=\"\" data-chapter=\"the-building\" class=\"building-mockup-div is--floor-plans\"><div class=\"the-building-left-align\"><div data-building-stage=\"\" class=\"floor-plan-img-wrap\"><img src=\"https://cdn.prod.website-files.com/6a6f5c166dbeec8fe50bd459/6a722754d6ef0dcf81906606_Floor%2017.png\" loading=\"eager\" width=\"648\" height=\"Auto\" alt=\"\" sizes=\"(max-width: 767px) 100vw, 648px\" srcset=\"https://cdn.prod.website-files.com/6a6f5c166dbeec8fe50bd459/6a722754d6ef0dcf81906606_Floor%2017-p-500.png 500w, https://cdn.prod.website-files.com/6a6f5c166dbeec8fe50bd459/6a722754d6ef0dcf81906606_Floor%2017-p-800.png 800w, https://cdn.prod.website-files.com/6a6f5c166dbeec8fe50bd459/6a722754d6ef0dcf81906606_Floor%2017-p-1080.png 1080w, https://c