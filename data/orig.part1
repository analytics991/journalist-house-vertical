tem\" class=\"units-hover-move w-dyn-item\"><div class=\"type-mobile_data-wrap\"><div class=\"type-mobile_data-div is--top-left\"><div class=\"type-mobile_unit-head\">Apartment Area</div></div><div class=\"type-mobile_data-div is--top-center\"><div class=\"type-mobile_unit-head\">Terrace Area</div></div><div class=\"type-mobile_data-div is--top-right\"><div class=\"type-mobile_unit-head\">ORIENTATION</div></div><div class=\"type-mobile_data-div is--bottom-left\"><div data-apartment-area=\"\" class=\"type-mobile_unit-data\">199</div><div class=\"type-mobile_unit-head is--sqm\">sqm</div></div><div class=\"type-mobile_data-div is--bottom-center\"><div data-balcony-area=\"\" class=\"type-mobile_unit-data\">55</div><div class=\"type-mobile_unit-head is--sqm\">sqm</div></div><div class=\"type-mobile_data-div is--bottom-right\"><div data-orientation=\"\" class=\"type-mobile_unit-data\">NE</div></div></div></div><div data-slug=\"1701\" role=\"listitem\" class=\"units-hover-move w-dyn-item\"><div class=\"type-mobile_data-wrap\"><div class=\"type-mobile_data-div is--top-left\"><div class=\"type-mobile_unit-head\">Apartment Area</div></div><div class=\"type-mobile_data-div is--top-center\"><div class=\"type-mobile_unit-head\">Terrace Area</div></div><div class=\"type-mobile_data-div is--top-right\"><div class=\"type-mobile_unit-head\">ORIENTATION</div></div><div class=\"type-mobile_data-div is--bottom-left\"><div data-apartment-area=\"\" class=\"type-mobile_unit-data\">213</div><div class=\"type-mobile_unit-head is--sqm\">sqm</div></div><div class=\"type-mobile_data-div is--bottom-center\"><div data-balcony-area=\"\" class=\"type-mobile_unit-data\">55</div><div class=\"type-mobile_unit-head is--sqm\">sqm</div></div><div class=\"type-mobile_data-div is--bottom-right\"><div data-orientation=\"\" class=\"type-mobile_unit-data\">NW</div></div></div></div></div></div></div><div class=\"type-mobile_controls-wrap\"><div class=\"floor-tag\"><div class=\"type-mobile_head\">Floor</div><