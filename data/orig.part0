nction pe(){g(),U(),window.scrollTo(0,0),E(X),E(J),E(W),E(re),E(ue),E(te),E(oe),E(de),E(fe),B(({gsap:e,ScrollTrigger:t})=>{t&&e.registerPlugin(t),E(F),E(G)})}document.readyState===\"loading\"?document.addEventListener(\"DOMContentLoaded\",pe):pe();})();\n//# sourceMappingURL=global.js.map\n"},"pages":{"/select-a-residence":{"title":"Select a Residence | Tel Aviv Luxury Apartments","bodyClass":"","embeds":[{"c":"global-css w-embed","h":"<style>\n  :root {\n    --font-from: 10;\n    --font-to: 10;\n    --vw-from: calc(1920 / 100);\n    --vw-to: calc(2849 / 100);\n    --coefficient: calc((var(--font-to) - var(--font-from)) / (var(--vw-to) - var(--vw-from)));\n    --base: calc((var(--font-from) - var(--vw-from) * var(--coefficient)) / 16);\n  }\n\n  html {\n    font-size: calc(var(--base) * 1rem + var(--coefficient) * 1vw);\n  }\n\n  @media screen and (max-width: 1920px) {\n    :root {\n      --font-from: 6;\n      --font-to: 10;\n      --vw-from: calc(991 / 100);\n      --vw-to: calc(1920 / 100);\n    }\n  }\n\n  @media screen and (max-width: 991px) {\n    :root {\n      --font-from: 10;\n      --font-to: 10;\n      --vw-from: calc(1 / 100);\n      --vw-to: calc(991 / 100);\n    }\n  }\n  @media screen and (min-width: 992px) {\n    .chapter-tile:hover .chapter-link-arrow {\n      transform: translate(0rem, 0px);\n    }\n  }\n</style>\n\n<style>\n  /* Remove gray tap highlight on iOS */\n  a,\n  button,\n  input,\n  textarea,\n  .contact-us_x-wrapper {\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  a,\n  button {\n    outline: 0;\n  }\n\n  /* Make text look crisper and more legible in all browsers */\n  body {\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n    font-smoothing: antialiased;\n  }\n\n  html.lenis,\n  html.lenis body {\n    height: auto;\n  }\n  .lenis.lenis-smooth {\n    scroll-behavior: auto !important;\n  }\n  .lenis.lenis-smooth [data-lenis-prevent] {\n    overscroll-behavior: contain;\n  }\n  .lenis.lenis-stopped {\n    overflow: hidden;\n  }\n  .lenis.lenis-smooth iframe {\n    pointer-events: none;\n  }\n  html.is-preloading {\n    overflow: hidden;\n  }\n</style>\n<style>\n  .wf-design-mode .loader {\n    display: none;\n  }\n  /* Add auto overflow in webflow to make editing easier */\n  .wf-design-mode [data-horizontal-scroll-wrap] {\n    overflow: auto;\n  }\n  [data-load-reset] {\n    opacity: 0;\n  }\n\n  .chapter-tile__thumb-wrapper:hover .chapter-tile__thumb {\n    transform: scale(1.05);\n  }\n\n  /* .chapter-tile:hover .chapter-link-arrow {\n    transform: translate(0rem, 0px);\n  } */\n  .chapter-tile:hover .chapter-link-hovered {\n    opacity: 1;\n  }\n</style>\n\n<style>\n  /* Chapter menu — always legible on any background.\n   White ink + difference blend = the menu paints as the inverse of whatever is\n   behind it, so it stays visible over any colour or full-bleed image. */\n  .chapter-menu-c {\n    mix-blend-mode: difference;\n    background-color: transparent; /* any solid bg here would blend and kill the effect */\n  }\n  /* Ink must be white so 'difference' inverts the backdrop into a contrasting colour. */\n  .chapter-menu-c {\n    color: #fff;\n  } /* label text */\n  .chapter-menu-c .chapter-track {\n    background-color: rgba(255, 255, 255, 0.35);\n  } /* faint line */\n  .chapter-menu-c .chapter-track-fake {\n    background-color: rgba(255, 255, 255, 0.35);\n  } /* faint line */\n\n  .chapter-menu-c .chapter-track-fake.is--journy-2 {\n    background-color: #fff;\n  } /* faint line */\n  .chapter-menu-c .chapter-fill {\n    background-color: #fff;\n  } /* progress fill */\n\n  /* Scroll-lock while the Inquire modal is open (Lenis is stopped; this kills native fallback scroll) */\n  html.is-inquire-open {\n    overflow: hidden;\n    scrollbar-gutter: stable;\n  }\n  /* Modal hidden until JS takes over */\n  [mt-el='inquire-modal'] {\n    display: none;\n  }\n\n  #language-bar,\n  .enable-bottomlinks-feedback,\n  .enable-toolbar-links-section.enable-toolbar-link-powered-by,\n  .keyboard-shorcut {\n    display: none !important;\n  }\n</style>\n\n<!-- Mobile Sliders thumbs and scrollbars -->\n<style>\n  @media (max-width: 991px) {\n    [data-scrollbar] {\n      overflow-x: auto;\n      overflow-y: hidden;\n      scrollbar-width: none;\n    }\n    [data-scrollbar]::-webkit-scrollbar {\n      display: none;\n    }\n    [data-scrollbar] > * {\n      flex-shrink: 0;\n    }\n  }\n\n  /* Override per slider by setting these variables on the slider's parent */\n  [data-scrollbar-track] {\n    position: relative;\n    width: var(--scrollbar-track-width, calc(100% - 4rem));\n    height: 3px;\n    margin: var(--scrollbar-gap, 24px) auto 0;\n  }\n  [data-scrollbar-track]::before {\n    content: '';\n    position: absolute;\n    left: 0;\n    right: 0;\n    top: 1px;\n    height: 1px;\n    background: #ddd8d7;\n  }\n  [data-scrollbar-thumb] {\n    position: relative;\n    width: 40px;\n    height: 100%;\n    background: #000;\n    touch-action: none;\n  }\n\n  @media (min-width: 992px) {\n    [data-scrollbar-track] {\n      display: none;\n    }\n  }\n</style>"},{"c":"page-styles w-embed","h":"<style>\n  /* ── Building floors — inverse hover highlight ──────────────────────────\n     Each floor's overlay (.the-building__veil) is hidden by default. Hovering\n     one floor reveals every OTHER floor's veil (dims the rest of the building),\n     leaving the hovered floor clear. */\n\n  /* 1. All floor veils hidden by default */\n  .the-building__veil {\n    opacity: 0;\n    transition: opacity 0.35s ease;\n  }\n\n  /* 2. When any floor is hovered, reveal every veil EXCEPT the hovered one.\n        The hovered floor keeps its default opacity: 0 (stays clear). */\n  body:has(.the-building_link:hover) .the-building__veil:not(:hover) {\n    opacity: 1;\n  }\n  @media (hover: none) {\n    /* iOS fires :hover on first tap; the desktop reveal then flips the selected\n     veil clear→dim, cancelling the tap. Pin it clear so nothing changes on tap. */\n    body:has(.the-building_link:hover) .the-building__veil.is--selected {\n      opacity: 0;\n    }\n  }\n\n  @media (hover: none) {\n    a,\n    button,\n    [role='button'],\n    input,\n    textarea,\n    select,\n    .the-building_link,\n    [data-floor-hover],\n    .type-mobile_btn {\n      -webkit-tap-highlight-color: transparent;\n    }\n  }\n  a:focus-visible,\n  button:focus-visible,\n  [role='button']:focus-visible,\n  .type-mobile_btn:focus-visible {\n    outline: 2px solid currentColor; /* swap for brand color */\n    outline-offset: 2px;\n  }\n\n  @media (max-width: 991px) {\n    .the-building__veil {\n      opacity: 1;\n    }\n    .the-building__veil.is--selected {\n      opacity: 0;\n    }\n  }\n  /* Fixed height so the building fits to HEIGHT (defeats the circular measure).\n   If your navbar is IN-FLOW above this section use calc(100svh - <navbar height>);\n   if it's fixed/overlaid, keep 100svh. */\n  @media (max-width: 991px), (pointer: coarse) {\n    [data-building-layout] {\n      height: 100svh;\n    }\n  }\n  /* Controls are mobile-only — rule MIRRORS the JS so iPad landscape (coarse ≥992px) keeps them. */\n  @media (min-width: 992px) and (pointer: fine) {\n    .type-mobile_controls-wrap {\n      display: none !important;\n    }\n  }\n  .type-mobile_btn[disabled],\n  .type-mobile_btn[aria-disabled='true'],\n  .type-mobile_btn.is--disabled {\n    opacity: 0.35;\n    pointer-events: none;\n    cursor: default;\n  }\n</style>"},{"c":"navbar-size-shrink-code w-embed","h":"<style>\n  @media (min-width: 992px) {\n    .chapter-tile__thumb-wrapper {\n      aspect-ratio: 277 / 291;\n      min-height: 0;\n      max-height: 100%;\n      overflow: hidden;\n    }\n\n    .chapter-tile__thumb {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      display: block;\n    }\n\n    .chapter-tile {\n      min-height: 0;\n      display: flex;\n      flex-direction: column;\n    }\n\n    .chapter-bottom_wrap {\n      flex: 0 0 auto;\n    }\n\n    .chapter-menu__grid {\n      flex: 0 1 auto;\n      min-height: 0;\n      align-content: center;\n    }\n  }\n</style>"},{"c":"hamburger_embed w-embed","h":"<style>\n  @media (min-width: 992px) {\n    .hamburger_5_wrap {\n      --thickness: 0.2rem;\n      --gap: 1rem;\n      --rotate: 35;\n      --width: 100%;\n    }\n    .w--open .hamburger_5_line {\n      transform: scaleX(0);\n    }\n    .w--open .hamburger_5_line:first-child {\n      transform: translateY(calc(var(--thickness) + var(--gap))) rotate(calc(var(--rotate) * -1deg));\n    }\n    .w--open .hamburger_5_line:last-child {\n      transform: translateY(calc(var(--thickness) * -1 + var(--gap) * -1)) rotate(calc(var(--rotate) * 1deg));\n    }\n  }\n\n    @media (max-width: 991px) {\n    .hamburger_5_wrap {\n      --thickness: 0.1rem;\n      --gap: 0.5rem;\n      --rotate: 45;\n      --width: 100%;\n    }\n    .w--open .hamburger_5_line {\n      transform: scaleX(0);\n    }\n    .w--open .hamburger_5_line:first-child {\n      transform: translateY(calc(var(--thickness) + var(--gap))) rotate(calc(var(--rotate) * -1deg));\n    }\n    .w--open .hamburger_5_line:last-child {\n      transform: translateY(calc(var(--thickness) * -1 + var(--gap) * -1)) rotate(calc(var(--rotate) * 1deg));\n    }\n  }\n</style>"}],"scripts":["https://jurnalist-house-2026.vercel.app/pages/plans.js"],"inline":["\n  // Hebrew locale (/he, dir=\"rtl\") loads the Hebrew build; every other page loads English.\n  document.write('<script defer src=\"https://jurnalist-house-2026.vercel.app/' + (document.documentElement.dir === \"rtl\" ? \"he/\" : \"\") + 'global.js\"><\\/script>');\n"],"main":"<section class=\"section_plans-hero\"><a href=\"/#the-building-links\" class=\"back-btn w-inline-block\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"11\" height=\"16\" viewBox=\"0 0 11 16\" fill=\"none\" class=\"back-btn-arrow\"><path d=\"M10.3438 0.580013L1.19082 7.99704L10.3438 15.4141\" stroke=\"#151515\" stroke-width=\"1.5\"></path></svg><div class=\"back-btn-text\">BACK</div></a><div data-pin-length=\"1.5\" data-horizontal-scroll-panel=\"\" data-chapter=\"the-building\" class=\"building-mockup-div\"><div class=\"the-building-left-align\"><div data-building-stage=\"\" class=\"the-building_inner-wrap\"><img class=\"the-building__img\" src=\"https://cdn.prod.website-files.com/6a4f7045e10baec12b17db43/6a61fe0e07bd3dfc7ac9c471_building-img.avif\" width=\"1023\" height=\"1038\" alt=\"\" data-building-img=\"\" sizes=\"100vw\" loading=\"eager\" srcset=\"https://cdn.prod.website-files.com/6a4f7045e10baec12b17db43/6a61fe0e07bd3dfc7ac9c471_building-img-p-500.avif 500w, https://cdn.prod.website-files.com/6a4f7045e10baec12b17db43/6a61fe0e07bd3dfc7ac9c471_building-img-p-800.avif 800w, https://cdn.prod.website-files.com/6a4f7045e10baec12b17db43/6a61fe0e07bd3dfc7ac9c471_building-img-p-1080.avif 1080w, https://cdn.prod.website-files.com/6a4f7045e10baec12b17db43/6a61fe0e07bd3dfc7ac9c471_building-img-p-1600.avif 1600w, https://cdn.prod.website-files.com/6a4f7045e10baec12b17db43/6a61fe0e07bd3dfc7ac9c471_building-img.avif 2046w\"><div class=\"the-building_top-reveal-wrap\"><div data-building-veil=\"\" class=\"the-building__veil is--ground-floor is--none-pointer\"></div><div class=\"the-building__veil is--garden\"><a data-name=\"Garden Terraces\" id=\"w-node-_28d15fba-7858-fef1-3fc9-5133778e1517-201ef613\" href=\"/floors/5\" class=\"the-building_link w-inline-block\"></a></div><div class=\"the-building__veil is--urban-residences\"><a data-name=\"Urban Residences\" id=\"w-node-_6a7ae349-e32a-5784-f7f7-9cfebee781e4-201ef613\" href=\"/cubes/urban-residences\" class=\"the-building_link is--selected w-inline-block\"></a></div><div class=\"the-building__veil is--double-villas\"><a data-name=\"Double-Height  Villas\" id=\"w-node-_29cb34d2-037a-43e0-e69c-5f9dfbf6a429-201ef613\" href=\"/cubes/double-height-villas\" class=\"the-building_link w-inline-block\"></a></div><div class=\"the-building__veil is--crown\"><a data-name=\"Crown Residences\" id=\"w-node-_8ce9936c-5219-9fbd-dacd-3c7d37aeddcd-201ef613\" href=\"/cubes/crown-residences\" class=\"the-building_link w-inline-block\"></a></div><div class=\"the-building__veil is--penthouse\"><a data-name=\"The Penthouse\" id=\"w-node-bf892bb8-10f0-d551-c3e0-4d632f1f34d0-201ef613\" href=\"/floors/penthouse\" class=\"the-building_link w-inline-block\"></a></div></div></div></div><div class=\"the-building_text-wrap is--select\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"33\" height=\"51\" viewBox=\"0 0 33 51\" fill=\"none\" class=\"the-building_arrow\"><path d=\"M32.554 50.259C31.8586 51.1172 30.5996 51.2492 29.7415 50.554L0.741465 27.054C0.272845 26.6742 0.000253947 26.1034 0.000253999 25.5002C0.0002552 24.8971 0.272846 24.3263 0.741465 23.9465L29.7415 0.446541C30.5996 -0.248736 31.8586 -0.116662 32.554 0.741463C33.2492 1.59964 33.1172 2.85858 32.259 3.55396L5.17701 25.5002L32.259 47.4465C33.1172 48.1419 33.2492 49.4009 32.554 50.259Z\" fill=\"#151515\"></path></svg><div data-name-target=\"\" class=\"the-building_hovered-text\">SELECT <br>THE SECTION</div></div></div><div class=\"type-mobile_controls-wrap\"><div class=\"type-mobile_head\">SELECT THE SECTION</div><div class=\"type-mobile_controls\"><button type=\"button\" data-floor-down=\"\" aria-label=\"Floor down\" class=\"type-mobile_btn\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"64\" height=\"30\" viewBox=\"0 0 64 30\" fill=\"none\" class=\"type-mobile_btn-arrow\"><path d=\"M39.0741 11.8004C39.2994 11.9601 39.3528 12.2724 39.1932 12.4977L33.7479 20.1842C33.6542 20.3166 33.5019 20.3952 33.3397 20.3952C33.1775 20.3952 33.0252 20.3166 32.9315 20.1842L27.4862 12.4977C27.3266 12.2724 27.38 11.9601 27.6053 11.8004C27.8306 11.6409 28.143 11.6943 28.3026 11.9196L33.3397 19.029L38.3768 11.9196C38.5364 11.6943 38.8487 11.6409 39.0741 11.8004Z\" fill=\"#151515\"></path></svg></button><div class=\"type-mobile_floor-level\"><div data-floor-level=\"\" class=\"type-mobile_floor-level-txt\">Garden Terraces</div></div><button type=\"button\" data-floor-up=\"\" aria-label=\"Floor up\" class=\"type-mobile_btn\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"64\" height=\"30\" viewBox=\"0 0 64 30\" fill=\"none\" class=\"type-mobile_btn-arrow\"><path d=\"M39.0741 20.3031C39.2994 20.1435 39.3528 19.8311 39.1932 19.6058L33.7479 11.9193C33.6542 11.787 33.5019 11.7083 33.3397 11.7083C33.1775 11.7083 33.0252 11.787 32.9315 11.9193L27.4862 19.6058C27.3266 19.8311 27.38 20.1435 27.6053 20.3031C27.8306 20.4626 28.143 20.4092 28.3026 20.1839L33.3397 13.0746L38.3768 20.1839C38.5364 20.4092 38.8487 20.4626 39.0741 20.3031Z\" fill=\"#151515\"></path></svg></button></div><button data-floor-enter=\"\" type=\"button\" aria-label=\"Enter Floor\" class=\"type-mobile_enter-btn\">ENTER SECTION</button></div></section>"},"/floors/10":{"title":"10th Floor Plan | Journalist House Tel Aviv","bodyClass":"","embeds":[{"c":"global-css w-embed","h":"<style>\n  :root {\n    --font-from: 10;\n    --font-to: 10;\n    --vw-from: calc(1920 / 100);\n    --vw-to: calc(2849 / 100);\n    --coefficient: calc((var(--font-to) - var(--font-from)) / (var(--vw-to) - var(--vw-from)));\n    --base: calc((var(--font-from) - var(--vw-from) * var(--coefficient)) / 16);\n  }\n\n  html {\n    font-size: calc(var(--base) * 1rem + var(--coefficient) * 1vw);\n  }\n\n  @media screen and (max-width: 1920px) {\n    :root {\n      --font-from: 6;\n      --font-to: 10;\n      --vw-from: calc(991 / 100);\n      --vw-to: calc(1920 / 100);\n    }\n  }\n\n  @media screen and (max-width: 991px) {\n    :root {\n      --font-from: 10;\n      --font-to: 10;\n      --vw-from: calc(1 / 100);\n      --vw-to: calc(991 / 100);\n    }\n  }\n  @media screen and (min-width: 992px) {\n    .chapter-tile:hover .chapter-link-arrow {\n      transform: translate(0rem, 0px);\n    }\n  }\n</style>\n\n<style>\n  /* Remove gray tap highlight on iOS */\n  a,\n  button,\n  input,\n  textarea,\n  .contact-us_x-wrapper {\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  a,\n  button {\n    outline: 0;\n  }\n\n  /* Make text look crisper and more legible in all browsers */\n  body {\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n    font-smoothing: antialiased;\n  }\n\n  html.lenis,\n  html.lenis body {\n    height: auto;\n  }\n  .lenis.lenis-smooth {\n    scroll-behavior: auto !important;\n  }\n  .lenis.lenis-smooth [data-lenis-prevent] {\n    overscroll-behavior: contain;\n  }\n  .lenis.lenis-stopped {\n    overflow: hidden;\n  }\n  .lenis.lenis-smooth iframe {\n    pointer-events: none;\n  }\n  html.is-preloading {\n    overflow: hidden;\n  }\n</style>\n<style>\n  .wf-design-mode .loader {\n    display: none;\n  }\n  /* Add auto overflow in webflow to make editing easier */\n  .wf-design-mode [data-horizontal-scroll-wrap] {\n    overflow: auto;\n  }\n  [data-load-reset] {\n    opacity: 0;\n  }\n\n  .chapter-tile__thumb-wrapper:hover .chapter-tile__thumb {\n    transform: scale(1.05);\n  }\n\n  /* .chapter-tile:hover .chapter-link-arrow {\n    transform: translate(0rem, 0px);\n  } */\n  .chapter-tile:hover .chapter-link-hovered {\n    opacity: 1;\n  }\n</style>\n\n<style>\n  /* Chapter menu — always legible on any background.\n   White ink + difference blend = the menu paints as the inverse of whatever is\n   behind it, so it stays visible over any colour or full-bleed image. */\n  .chapter-menu-c {\n    mix-blend-mode: difference;\n    background-color: transparent; /* any solid bg here would blend and kill the effect */\n  }\n  /* Ink must be white so 'difference' inverts the backdrop into a contrasting colour. */\n  .chapter-menu-c {\n    color: #fff;\n  } /* label text */\n  .chapter-menu-c .chapter-track {\n    background-color: rgba(255, 255, 255, 0.35);\n  } /* faint line */\n  .chapter-menu-c .chapter-track-fake {\n    background-color: rgba(255, 255, 255, 0.35);\n  } /* faint line */\n\n  .chapter-menu-c .chapter-track-fake.is--journy-2 {\n    background-color: #fff;\n  } /* faint line */\n  .chapter-menu-c .chapter-fill {\n    background-color: #fff;\n  } /* progress fill */\n\n  /* Scroll-lock while the Inquire modal is open (Lenis is stopped; this kills native fallback scroll) */\n  html.is-inquire-open {\n    overflow: hidden;\n    scrollbar-gutter: stable;\n  }\n  /* Modal hidden until JS takes over */\n  [mt-el='inquire-modal'] {\n    display: none;\n  }\n\n  #language-bar,\n  .enable-bottomlinks-feedback,\n  .enable-toolbar-links-section.enable-toolbar-link-powered-by,\n  .keyboard-shorcut {\n    display: none !important;\n  }\n</style>\n\n<!-- Mobile Sliders thumbs and scrollbars -->\n<style>\n  @media (max-width: 991px) {\n    [data-scrollbar] {\n      overflow-x: auto;\n      overflow-y: hidden;\n      scrollbar-width: none;\n    }\n    [data-scrollbar]::-webkit-scrollbar {\n      display: none;\n    }\n    [data-scrollbar] > * {\n      flex-shrink: 0;\n    }\n  }\n\n  /* Override per slider by setting these variables on the slider's parent */\n  [data-scrollbar-track] {\n    position: relative;\n    width: var(--scrollbar-track-width, calc(100% - 4rem));\n    height: 3px;\n    margin: var(--scrollbar-gap, 24px) auto 0;\n  }\n  [data-scrollbar-track]::before {\n    content: '';\n    position: absolute;\n    left: 0;\n    right: 0;\n    top: 1px;\n    height: 1px;\n    background: #ddd8d7;\n  }\n  [data-scrollbar-thumb] {\n    position: relative;\n    width: 40px;\n    height: 100%;\n    background: #000;\n    touch-action: none;\n  }\n\n  @media (min-width: 992px) {\n    [data-scrollbar-track] {\n      display: none;\n    }\n  }\n</style>"},{"c":"page-styles w-embed","h":"<style>\n  /* See-the-Residences — global sequence gallery */\n\n  /* Take over the sliders: stack every slide in one grid cell + kill Webflow's\n   slide transforms; the bundle owns opacity for the crossfade. */\n  .gallery_slider.is--managed .gallery_mask {\n    display: grid;\n  }\n  .gallery_slider.is--managed .gallery_slide {\n    grid-area: 1 / 1;\n    transform: none !important;\n    opacity: 0;\n  }\n  .gallery_slider.is--managed .gallery_slide.is--active {\n    opacity: 1;\n  }\n\n  /* Hide the native per-slider arrows + dots — one global control drives them. */\n  .gallery_slider .w-slider-arrow-left,\n  .gallery_slider .w-slider-arrow-right,\n  .gallery_slider .w-slider-nav {\n    display: none !important;\n  }\n\n  /* Global arrows: disabled look at the sequence ends (JS toggles data-disabled). */\n  [data-gallery-arrow][data-disabled] {\n    opacity: 0.35;\n    pointer-events: none;\n  }\n</style>\n<style>\n  .mt-unit-details .unit-status {\n    position: static; /* kill any leftover absolute positioning */\n    display: block;\n    margin-bottom: 0rem; /* space between it and APARTMENT AREA — tune to taste */\n  }\n  .mt-unit-details {\n    margin-top: 2rem;\n  }\n  .is--unavailable path {\n    fill: black;\n  }\n\n  /* positioning context for the out-of-flow sub-line */\n  .the-building_hovered-text {\n    position: relative;\n  }\n\n  .unit-status {\n    position: absolute;\n    left: 0; /* align to the UNIT / number left edge */\n    top: 90%; /* below the label, no added height */\n    margin-top: 0.25em;\n    font-size: 0.55em; /* smaller than the unit number */\n    letter-spacing: normal; /* was 0.06em → too wide */\n    text-transform: uppercase;\n    text-align: left;\n    white-space: nowrap;\n    opacity: 0.65;\n  }\n</style>\n<style>\n  /*MOBILE  */\n  .type-mobile_floor-level-txt, [unit-data-wrap] {\n    opacity: 0;\n    visibility: hidden;\n  }\n</style>"},{"c":"navbar-size-shrink-code w-embed","h":"<style>\n  @media (min-width: 992px) {\n    .chapter-tile__thumb-wrapper {\n      aspect-ratio: 277 / 291;\n      min-height: 0;\n      max-height: 100%;\n      overflow: hidden;\n    }\n\n    .chapter-tile__thumb {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      display: block;\n    }\n\n    .chapter-tile {\n      min-height: 0;\n      display: flex;\n      flex-direction: column;\n    }\n\n    .chapter-bottom_wrap {\n      flex: 0 0 auto;\n    }\n\n    .chapter-menu__grid {\n      flex: 0 1 auto;\n      min-height: 0;\n      align-content: center;\n    }\n  }\n</style>"},{"c":"hamburger_embed w-embed","h":"<style>\n  @media (min-width: 992px) {\n    .hamburger_5_wrap {\n      --thickness: 0.2rem;\n      --gap: 1rem;\n      --rotate: 35;\n      --width: 100%;\n    }\n    .w--open .hamburger_5_line {\n      transform: scaleX(0);\n    }\n    .w--open .hamburger_5_line:first-child {\n      transform: translateY(calc(var(--thickness) + var(--gap))) rotate(calc(var(--rotate) * -1deg));\n    }\n    .w--open .hamburger_5_line:last-child {\n      transform: translateY(calc(var(--thickness) * -1 + var(--gap) * -1)) rotate(calc(var(--rotate) * 1deg));\n    }\n  }\n\n    @media (max-width: 991px) {\n    .hamburger_5_wrap {\n      --thickness: 0.1rem;\n      --gap: 0.5rem;\n      --rotate: 45;\n      --width: 100%;\n    }\n    .w--open .hamburger_5_line {\n      transform: scaleX(0);\n    }\n    .w--open .hamburger_5_line:first-child {\n      transform: translateY(calc(var(--thickness) + var(--gap))) rotate(calc(var(--rotate) * -1deg));\n    }\n    .w--open .hamburger_5_line:last-child {\n      transform: translateY(calc(var(--thickness) * -1 + var(--gap) * -1)) rotate(calc(var(--rotate) * 1deg));\n    }\n  }\n</style>"}],"scripts":["https://jurnalist-house-2026.vercel.app/pages/floors.js"],"inline":["\n  // Hebrew locale (/he, dir=\"rtl\") loads the Hebrew build; every other page loads English.\n  document.write('<script defer src=\"https://jurnalist-house-2026.vercel.app/' + (document.documentElement.dir === \"rtl\" ? \"he/\" : \"\") + 'global.js\"><\\/script>');\n"],"main":"<section class=\"section_plans-hero\"><a mt-el=\"back-history\" href=\"#\" class=\"back-btn w-inline-block\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"11\" height=\"16\" viewBox=\"0 0 11 16\" fill=\"none\" class=\"back-btn-arrow\"><path d=\"M10.3438 0.580013L1.19082 7.99704L10.3438 15.4141\" stroke=\"#151515\" stroke-width=\"1.5\"></path></svg><div class=\"back-btn-text\">BACK</div></a><div data-pin-length=\"1.5\" data-horizontal-scroll-panel=\"\" data-chapter=\"the-building\" class=\"building-mockup-div is--floor-plans\"><div class=\"the-building-left-align\"><div data-building-stage=\"\" class=\"floor-plan-img-wrap\"><img src=\"https://cdn.prod.website-files.com/6a6f5c166dbeec8fe50bd459/6a7221f06c3d1481844e5209_floor-10.png\" loading=\"eager\" width=\"648\" height=\"Auto\" alt=\"\" sizes=\"(max-width: 767px) 100vw, 648px\" srcset=\"https://cdn.prod.website-files.com/6a6f5c166dbeec8fe50bd459/6a7221f06c3d1481844e5209_floor-10-p-500.png 500w, https://cdn.prod.website-files.com/6a6f5c166dbeec8fe50bd459/6a7221f06c3d1481844e5209_floor-10-p-800.png 800w, https://cdn.prod.website-files.com/6a6f5c166dbeec8fe50bd459/6a7221f06c3d1481844e5209_floor-10-p-1080.png 1080w, https://cdn.prod.website-files.com/6a6f5c166dbeec8fe50bd459/6a7221f06c3d1481844e5209_floor-10.png 1562w\" class=\"floor-plan-bg\"></div></div><div class=\"the-building_text-wrap is--floors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"33\" height=\"51\" viewBox=\"0 0 33 51\" fill=\"none\" class=\"the-building_arrow\"><path d=\"M32.554 50.259C31.8586 51.1172 30.5996 51.2492 29.7415 50.554L0.741465 27.054C0.272845 26.6742 0.000253947 26.1034 0.000253999 25.5002C0.0002552 24.8971 0.272846 24.3263 0.741465 23.9465L29.7415 0.446541C30.5996 -0.248736 31.8586 -0.116662 32.554 0.741463C33.2492 1.59964 33.1172 2.85858 32.259 3.55396L5.17701 25.5002L32.259 47.4465C33.1172 48.1419 33.2492 49.4009 32.554 50.259Z\" fill=\"#151515\"></path></svg><div class=\"the-building_text-wrap-inner\"><div data-name-target=\"\" class=\"the-building_hovered-text\">SELECT <br>THE UNIT</div><div class=\"hidden-data-wrap w-dyn-list\"><div role=\"list\" class=\"units-hover-list w-dyn-items\"><div data-slug=\"1008\" role=\"listitem\" class=\"units-hover