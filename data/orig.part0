></div><div class=\"type-mobile_data-div is--bottom-left\"><div data-apartment-area=\"\" class=\"type-mobile_unit-data\">161</div><div class=\"type-mobile_unit-head is--sqm\">sqm</div></div><div class=\"type-mobile_data-div is--bottom-center\"><div data-balcony-area=\"\" class=\"type-mobile_unit-data\">23</div><div class=\"type-mobile_unit-head is--sqm\">sqm</div></div><div class=\"type-mobile_data-div is--bottom-right\"><div data-orientation=\"\" class=\"type-mobile_unit-data w-dyn-bind-empty\"></div></div></div></div><div data-slug=\"1001\" role=\"listitem\" class=\"units-hover-move w-dyn-item\"><div class=\"type-mobile_data-wrap\"><div class=\"type-mobile_data-div is--top-left\"><div class=\"type-mobile_unit-head\">Apartment Area</div></div><div class=\"type-mobile_data-div is--top-center\"><div class=\"type-mobile_unit-head\">Terrace Area</div></div><div class=\"type-mobile_data-div is--top-right\"><div class=\"type-mobile_unit-head\">ORIENTATION</div></div><div class=\"type-mobile_data-div is--bottom-left\"><div data-apartment-area=\"\" class=\"type-mobile_unit-data\">161</div><div class=\"type-mobile_unit-head is--sqm\">sqm</div></div><div class=\"type-mobile_data-div is--bottom-center\"><div data-balcony-area=\"\" class=\"type-mobile_unit-data\">23</div><div class=\"type-mobile_unit-head is--sqm\">sqm</div></div><div class=\"type-mobile_data-div is--bottom-right\"><div data-orientation=\"\" class=\"type-mobile_unit-data w-dyn-bind-empty\"></div></div></div></div></div></div></div><div class=\"type-mobile_controls-wrap\"><div class=\"floor-tag\"><div class=\"type-mobile_head\">Floor</div><div class=\"type-mobile_head\">10</div><div class=\"type-mobile_head\">-</div><div class=\"type-mobile_head\">SELECT THE UNIT</div></div><div class=\"type-mobile_controls\"><button type=\"button\" data-floor-down=\"\" aria-label=\"Floor down\" class=\"type-mobile_btn\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"64\" height=\"30\" viewBox=\"0 0 64 30\" fill=\"none\" class=\"type-mobile_btn-arrow\"><path d=\"M39.0741 20.3031C39.2994 20.1435 39.3528 19.8311 39.1932 19.6058L33.7479 11.9193C33.6542 11.787 33.5019 11.7083 33.3397 11.7083C33.1775 11.7083 33.0252 11.787 32.9315 11.9193L27.4862 19.6058C27.3266 19.8311 27.38 20.1435 27.6053 20.3031C27.8306 20.4626 28.143 20.4092 28.3026 20.1839L33.3397 13.0746L38.3768 20.1839C38.5364 20.4092 38.8487 20.4626 39.0741 20.3031Z\" fill=\"#151515\"></path></svg></button><div class=\"type-mobile_floor-level\"><div data-floor-level=\"\" class=\"type-mobile_floor-level-txt\">000</div></div><button type=\"button\" data-floor-up=\"\" aria-label=\"Floor up\" class=\"type-mobile_btn\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"64\" height=\"30\" viewBox=\"0 0 64 30\" fill=\"none\" class=\"type-mobile_btn-arrow\"><path d=\"M39.0741 11.8004C39.2994 11.9601 39.3528 12.2724 39.1932 12.4977L33.7479 20.1842C33.6542 20.3166 33.5019 20.3952 33.3397 20.3952C33.1775 20.3952 33.0252 20.3166 32.9315 20.1842L27.4862 12.4977C27.3266 12.2724 27.38 11.9601 27.6053 11.8004C27.8306 11.6409 28.143 11.6943 28.3026 11.9196L33.3397 19.029L38.3768 11.9196C38.5364 11.6943 38.8487 11.6409 39.0741 11.8004Z\" fill=\"#151515\"></path></svg></button></div><button data-floor-enter=\"\" type=\"button\" aria-label=\"Enter Floor\" class=\"type-mobile_enter-btn is--disabled\">ENTER UNIT</button></div></div></section><div class=\"hide\"><div data-unit-status-list=\"a\" class=\"w-dyn-list\"><div role=\"list\" class=\"w-dyn-items\"><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1001\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1002\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1003\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" data-slug=\"1004\"></div></div><div role=\"listitem\" class=\"w-dyn-item\"><div data-status=\"Unavailable\" 