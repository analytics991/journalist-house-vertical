2 2.85858 32.259 3.55396L5.17701 25.5002L32.259 47.4465C33.1172 48.1419 33.2492 49.4009 32.554 50.259Z\" fill=\"#151515\"></path></svg><div class=\"the-building_text-wrap-inner\"><div data-name-target=\"\" class=\"the-building_hovered-text\">SELECT <br>THE UNIT</div><div class=\"hidden-data-wrap w-dyn-list\"><div role=\"list\" class=\"units-hover-list w-dyn-items\"><div data-slug=\"2001\" role=\"listitem\" class=\"units-hover-move w-dyn-item\"><div class=\"units-details-wrap\"><div><div class=\"units_text-wrapper\"><div class=\"units_medium-text is--hovered\">Apartment Area</div><div mt-el=\"ctx-area\" class=\"units_texts-inner\"><div class=\"units_big-text is--hovered\">370</div><div class=\"units_small-text is--hovered\">sqm</div></div></div><div class=\"units_text-wrapper\"><div mt-el=\"ctx-outdoor-label\" class=\"units_medium-text is--hovered\">Terrace Area</div><div mt-el=\"ctx-outdoor\" class=\"units_texts-inner\"><div class=\"units_big-text is--hovered\">330</div><div class=\"units_small-text is--hovered\">sqm</div></div></div></div></div></div></div></div></div></div></div><div class=\"mobile-data-wrap\"><div unit-data-wrap=\"\" class=\"type-mobile_controls-wrap is--top\"><div class=\"w-dyn-list\"><div role=\"list\" class=\"type-mobile_controls w-dyn-items\"><div data-slug=\"2001\" role=\"listitem\" class=\"units-hover-move w-dyn-item\"><div class=\"type-mobile_data-wrap\"><div class=\"type-mobile_data-div is--top-left\"><div class=\"type-mobile_unit-head\">Apartment Area</div></div><div class=\"type-mobile_data-div is--top-center\"><div class=\"type-mobile_unit-head\">Terrace Area</div></div><div class=\"type-mobile_data-div is--top-right\"><div class=\"type-mobile_unit-head\">ORIENTATION</div></div><div class=\"type-mobile_data-div is--bottom-left\"><div data-apartment-area=\"\" class=\"type-mobile_unit-data\">370</div><div class=\"type-mobile_unit-head is--sqm\">sqm</div></div><div class=\"type-mobile_data-div is--bottom-center\"><div data-balcony-area=\"