26.1034 0.000253999 25.5002C0.0002552 24.8971 0.272846 24.3263 0.741465 23.9465L29.7415 0.446541C30.5996 -0.248736 31.8586 -0.116662 32.554 0.741463C33.2492 1.59964 33.1172 2.85858 32.259 3.55396L5.17701 25.5002L32.259 47.4465C33.1172 48.1419 33.2492 49.4009 32.554 50.259Z\" fill=\"#151515\"></path></svg><div><div data-name-target=\"\" class=\"the-building_hovered-text\">SELECT <br>THE FLOOR</div></div></div></div><div class=\"type-mobile_controls-wrap\"><div class=\"type-mobile_head\">SELECT THE FLOOR</div><div class=\"type-mobile_controls\"><button type=\"button\" data-floor-down=\"\" aria-label=\"Floor down\" class=\"type-mobile_btn\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"64\" height=\"30\" viewBox=\"0 0 64 30\" fill=\"none\" class=\"type-mobile_btn-arrow\"><path d=\"M39.0741 11.8004C39.2994 11.9601 39.3528 12.2724 39.1932 12.4977L33.7479 20.1842C33.6542 20.3166 33.5019 20.3952 33.3397 20.3952C33.1775 20.3952 33.0252 20.3166 32.9315 20.1842L27.4862 12.4977C27.3266 12.2724 27.38 11.9601 27.6053 11.8004C27.8306 11.6409 28.143 11.6943 28.3026 11.9196L33.3397 19.029L38.3768 11.9196C38.5364 11.6943 38.8487 11.6409 39.0741 11.8004Z\" fill=\"#151515\"></path></svg></button><div class=\"type-mobile_floor-level\"><div data-floor-level=\"\" class=\"type-mobile_floor-level-txt\">Floor \"N\"</div></div><button type=\"button\" data-floor-up=\"\" aria-label=\"Floor up\" class=\"type-mobile_btn\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"64\" height=\"30\" viewBox=\"0 0 64 30\" fill=\"none\" class=\"type-mobile_btn-arrow\"><path d=\"M39.0741 20.3031C39.2994 20.1435 39.3528 19.8311 39.1932 19.6058L33.7479 11.9193C33.6542 11.787 33.5019 11.7083 33.3397 11.7083C33.1775 11.7083 33.0252 11.787 32.9315 11.9193L27.4862 19.6058C27.3266 19.8311 27.38 20.1435 27.6053 20.3031C27.8306 20.4626 28.143 20.4092 28.3026 20.1839L33.3397 13.0746L38.3768 20.1839C38.5364 20.4092 38.8487 20.4626 39.0741 20.3031Z\" fill=\"#151515\"></path></svg></button></div><button data-floor-enter=\"\" type=\"button\" aria-label=\"Enter Floor\" class=\"type-mobile_enter-btn is--disabled\">ENTER FLOOR</button></div></section>"},"/apartments/601":{"title":"Unit 601 on floor 6th | Journalist House Tel Aviv","bodyClass":"","embeds":[{"c":"global-css w-embed","h":"<style>\n  :root {\n    --font-from: 10;\n    --font-to: 10;\n    --vw-from: calc(1920 / 100);\n    --vw-to: calc(2849 / 100);\n    --coefficient: calc((var(--font-to) - var(--font-from)) / (var(--vw-to) - var(--vw-from)));\n    --base: calc((var(--font-from) - var(--vw-from) * var(--coefficient)) / 16);\n  }\n\n  html {\n    font-size: calc(var(--base) * 1rem + var(--coefficient) * 1vw);\n  }\n\n  @media screen and (max-width: 1920px) {\n    :root {\n      --font-from: 6;\n      --font-to: 10;\n      --vw-from: calc(991 / 100);\n      --vw-to: calc(1920 / 100);\n    }\n  }\n\n  @media screen and (max-width: 991px) {\n    :root {\n      --font-from: 10;\n      --font-to: 10;\n      --vw-from: calc(1 / 100);\n      --vw-to: calc(991 / 100);\n    }\n  }\n  @media screen and (min-width: 992px) {\n    .chapter-tile:hover .chapter-link-arrow {\n      transform: translate(0rem, 0px);\n    }\n  }\n</style>\n\n<style>\n  /* Remove gray tap highlight on iOS */\n  a,\n  button,\n  input,\n  textarea,\n  .contact-us_x-wrapper {\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  a,\n  button {\n    outline: 0;\n  }\n\n  /* Make text look crisper and more legible in all browsers */\n  body {\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n    font-smoothing: antialiased;\n  }\n\n  html.lenis,\n  html.lenis body {\n    height: auto;\n  }\n  .lenis.lenis-smooth {\n    scroll-behavior: auto !important;\n  }\n  .lenis.lenis-smooth [data-lenis-prevent] {\n    overscroll-behavior: contain;\n  }\n  .lenis.lenis-stopped {\n    overflow: hidden;\n  }\n  .lenis.lenis-smooth iframe {\n    pointer-events: none;\n  }\n  html.is-preloading {\n    overflow: hidden;\n  }\n</style>\n<style>\n  .wf-design-mode .loader {\n    display: none;\n  }\n  /* Add auto overflow in webflow to make editing easier */\n  .wf-design-mode [data-horizontal-scroll-wrap] {\n    overflow: auto;\n  }\n  [data-load-reset] {\n    opacity: 0;\n  }\n\n  .chapter-tile__thumb-wrapper:hover .chapter-tile__thumb {\n    transform: scale(1.05);\n  }\n\n  /* .chapter-tile:hover .chapter-link-arrow {\n    transform: translate(0rem, 0px);\n  } */\n  .chapter-tile:hover .chapter-link-hovered {\n    opacity: 1;\n  }\n</style>\n\n<style>\n  /* Chapter menu — always legible on any background.\n   White ink + difference blend = the menu paints as the inverse of whatever is\n   behind it, so it stays visible over any colour or full-bleed image. */\n  .chapter-menu-c {\n    mix-blend-mode: difference;\n    background-color: transparent; /* any solid bg here would blend and kill the effect */\n  }\n  /* Ink must be white so 'difference' inverts the backdrop into a contrasting colour. */\n  .chapter-menu-c {\n    color: #fff;\n  } /* label text */\n  .chapter-menu-c .chapter-track {\n    background-color: rgba(255, 255, 255, 0.35);\n  } /* faint line */\n  .chapter-menu-c .chapter-track-fake {\n    background-color: rgba(255, 255, 255, 0.35);\n  } /* faint line */\n\n  .chapter-menu-c .chapter-track-fake.is--journy-2 {\n    background-color: #fff;\n  } /* faint line */\n  .chapter-menu-c .chapter-fill {\n    background-color: #fff;\n  } /* progress fill */\n\n  /* Scroll-lock while the Inquire modal is open (Lenis is stopped; this kills native fallback scroll) */\n  html.is-inquire-open {\n    overflow: hidden;\n    scrollbar-gutter: stable;\n  }\n  /* Modal hidden until JS takes over */\n  [mt-el='inquire-modal'] {\n    display: none;\n  }\n\n  #language-bar,\n  .enable-bottomlinks-feedback,\n  .enable-toolbar-links-section.enable-toolbar-link-powered-by,\n  .keyboard-shorcut {\n    display: none !important;\n  }\n</style>\n\n<!-- Mobile Sliders thumbs and scrollbars -->\n<style>\n  @media (max-width: 991px) {\n    [data-scrollbar] {\n      overflow-x: auto;\n      overflow-y: hidden;\n      scrollbar-width: none;\n    }\n    [data-scrollbar]::-webkit-scrollbar {\n      display: none;\n    }\n    [data-scrollbar] > * {\n      flex-shrink: 0;\n    }\n  }\n\n  /* Override per slider by setting these variables on the slider's parent */\n  [data-scrollbar-track] {\n    position: relative;\n    width: var(--scrollbar-track-width, calc(100% - 4rem));\n    height: 3px;\n    margin: var(--scrollbar-gap, 24px) auto 0;\n  }\n  [data-scrollbar-track]::before {\n    content: '';\n    position: absolute;\n    left: 0;\n    right: 0;\n    top: 1px;\n    height: 1px;\n    background: #ddd8d7;\n  }\n  [data-scrollbar-thumb] {\n    position: relative;\n    width: 40px;\n    height: 100%;\n    background: #000;\n    touch-action: none;\n  }\n\n  @media (min-width: 992px) {\n    [data-scrollbar-track] {\n      display: none;\n    }\n  }\n</style>"},{"c":"page-styles w-embed","h":"<style>\n  [mt-unit-floor='Urban Residences'].units-nav_building-link {\n    opacity: 1;\n  }\n\n  [href='/apartments/601'] {\n    opacity: 1;\n  }\n  .is--unavailable path {\n    fill: black;\n    opacity: 0.4 !important;\n  }\n\n  @media screen and (max-width: 379px) {\n    .units_left-inner {\n      display: flex;\n      grid-auto-columns: 1fr;\n    }\n  }\n\n  /* Mobile/touch: iOS treats the first tap as :hover, and the units-nav hotspots\n   fade 0 -> ~0.5 on hover, so the first tap is eaten and only the second navigates.\n   Pin :hover = resting opacity on touch so a single tap fires the link immediately.\n   Desktop hover (hover:hover) is untouched. */\n  @media (hover: none) {\n    .units-nav_building-link:hover,\n    .units-nav__top-view-link:hover {\n      opacity: 0;\n    }\n  }\n</style>"},{"c":"navbar-size-shrink-code w-embed","h":"<style>\n  @media (min-width: 992px) {\n    .chapter-tile__thumb-wrapper {\n      aspect-ratio: 277 / 291;\n      min-height: 0;\n      max-height: 100%;\n      overflow: hidden;\n    }\n\n    .chapter-tile__thumb {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      display: block;\n    }\n\n    .chapter-tile {\n      min-height: 0;\n      display: flex;\n      flex-direction: column;\n    }\n\n    .chapter-bottom_wrap {\n      flex: 0 0 auto;\n    }\n\n    .chapter-menu__grid {\n      flex: 0 1 auto;\n      min-height: 0;\n      align-content: center;\n    }\n  }\n</style>"},{"c":"hamburger_embed w-embed","h":"<style>\n  @media (min-width: 992px) {\n    .hamburger_5_wrap {\n      --thickness: 0.2rem;\n      --gap: 1rem;\n      --rotate: 35;\n      --width: 100%;\n    }\n    .w--open .hamburger_5_line {\n      transform: scaleX(0);\n    }\n    .w--open .hamburger_5_line:first-child {\n      transform: translateY(calc(var(--thickness) + var(--gap))) rotate(calc(var(--rotate) * -1deg));\n    }\n    .w--open .hamburger_5_line:last-child {\n      transform: translateY(calc(var(--thickness) * -1 + var(--gap) * -1)) rotate(calc(var(--rotate) * 1deg));\n    }\n  }\n\n    @media (max-width: 991px) {\n    .hamburger_5_wrap {\n      --thickness: 0.1rem;\n      --gap: 0.5rem;\n      --rotate: 45;\n      --width: 100%;\n    }\n    .w--open .hamburger_5_line {\n      transform: scaleX(0);\n    }\n    .w--open .hamburger_5_line:first-child {\n      transform: translateY(calc(var(--thickness) + var(--gap))) rotate(calc(var(--rotate) * -1deg));\n    }\n    .w--open .hamburger_5_line:last-child {\n      transform: translateY(calc(var(--thickness) * -1 + var(--gap) * -1)) rotate(calc(var(--rotate) * 1deg));\n    }\n  }\n</style>"}],"scripts":["https://jurnalist-house-2026.vercel.app/pages/apartments.js"],"inline":["\n  // Hebrew locale (/he, dir=\"rtl\") loads the Hebrew build; every other page loads English.\n  document.write('<script defer src=\"https://jurnalist-house-2026.vercel.app/' + (document.documentElement.dir === \"rtl\" ? \"he/\" : \"\") + 'global.js\"><\\/script>');\n"],"main":"<section class=\"sec