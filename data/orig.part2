00.5L514 255.5L491 245L490.5 269L355.5 342.5L324 327.5V323L349.5 309L322 296L293.5 311L227.5 281.5V275.5L168 246.5L162.5 251L67.5 207L35 224.5Z\" fill=\"#D79A9A\" fill-opacity=\"0.5\"></path></a><a href=\"/floors/19\" data-floor-hover=\"floor-19\"><path id=\"floor 19\" d=\"M35.5 187V191.5L162.5 251L168 246.5L227.5 275V281.5L293.5 310.5L322 296L349.5 309L324 323V327.5L355.5 342.5L490.5 269L491 245L514 255.5L647 183V179L587 151V144L585 143.5L585.5 114L519.5 83.5L488 100.5L453.5 85L451 86.5L326.5 28L309 38L305.5 35.5L223.5 80.5V84L204 95L168.5 78.5L136.5 97V128L94.5 150.5V155L35.5 187Z\" fill=\"#D6C177\" fill-opacity=\"0.5\"></path></a></g></svg></div><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"71\" height=\"59\" viewBox=\"0 0 71 59\" fill=\"none\" class=\"north-nav is--crown\"><path d=\"M58.1408 47.8639L24.7691 0.000214289L23.8784 28.0825L0.00381864 42.8949L58.1408 47.8639Z\" fill=\"#303030\"></path><path d=\"M61.3644 58.1873L62.8695 58.1873C63.0367 58.1873 63.1791 58.0612 63.1791 57.9119C63.1791 56.0616 63.1939 54.2112 63.1747 52.3609C63.1667 51.5899 63.1425 50.8189 63.0955 50.0496C63.914 51.4253 64.8557 52.7359 65.793 54.0521C66.7255 55.3611 67.6393 56.6817 68.5903 57.9797C68.7636 58.217 68.9995 58.1867 69.2899 58.1867L70.6514 58.1867C70.8185 58.1867 70.9609 58.0606 70.9609 57.9114L70.9609 46.9079C70.9609 46.8236 70.9256 46.7592 70.8718 46.7151C70.8223 46.6656 70.7486 46.6325 70.6514 46.6325L69.1463 46.6325C68.9791 46.6325 68.8367 46.7586 68.8367 46.9079C68.8367 48.8386 68.8225 50.7694 68.8416 52.7001C68.8491 53.4623 68.8683 54.2239 68.9017 54.985C68.0473 53.5477 67.0511 52.1781 66.0822 50.8002C65.1609 49.4907 64.2396 48.1816 63.319 46.8721C63.2955 46.8385 63.2738 46.8005 63.2466 46.7691C63.1035 46.6055 62.911 46.6325 62.7036 46.6325L61.3644 46.6325C61.1972 46.6325 61.0548 46.7586 61.0548 46.9079L61.0548 57.9119C61.0548 58.0606 61.1966 58.1873 61.3644 58.1873Z\" fill=\"#303030\"></path></svg></div></div><div class=\"the-building_text-wrap is--floors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"33\" height=\"51\" viewBox=\"0 0 33 51\" fill=\"none\" class=\"the-building_arrow\"><path d=\"M32.554 50.259C31.8586 51.1172 30.5996 51.2492 29.7415 50.554L0.741465 27.054C0.272845 26.6742 0.000253947 26.1034 0.000253999 25.5002C0.0002552 24.8971 0.272846 24.3263 0.741465 23.9465L29.7415 0.446541C30.5996 -0.248736 31.8586 -0.116662 32.554 0.741463C33.2492 1.59964 33.1172 2.85858 32.259 3.55396L5.17701 25.5002L32.259 47.4465C33.1172 48.1419 33.2492 49.4009 32.554 50.259Z\" fill=\"#151515\"></path></svg><div><div data-name-target=\"\" class=\"the-building_hovered-text\">SELECT <br>THE FLOOR</div></div></div></div><div class=\"type-mobile_controls-wrap\"><div class=\"type-mobile_head\">SELECT THE FLOOR</div><div class=\"type-mobile_controls\"><button type=\"button\" data-floor-down=\"\" aria-label=\"Floor down\" class=\"type-mobile_btn\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"64\" height=\"30\" viewBox=\"0 0 64 30\" fill=\"none\" class=\"type-mobile_btn-arrow\"><path d=\"M39.0741 11.8004C39.2994 11.9601 39.3528 12.2724 39.1932 12.4977L33.7479 20.1842C33.6542 20.3166 33.5019 20.3952 33.3397 20.3952C33.1775 20.3952 33.0252 20.3166 32.9315 20.1842L27.4862 12.4977C27.3266 12.2724 27.38 11.9601 27.6053 11.8004C27.8306 11.6409 28.143 11.6943 28.3026 11.9196L33.3397 19.029L38.3768 11.9196C38.5364 11.6943 38.8487 11.6409 39.0741 11.8004Z\" fill=\"#151515\"></path></svg></button><div class=\"type-mobile_floor-level\"><div data-floor-level=\"\" class=\"type-mobile_floor-level-txt\">Floor \"N\"</div></div><button type=\"button\" data-floor-up=\"\" aria-label=\"Floor up\" class=\"type-mobile_btn\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"64\" height=\"30\" viewBox=\"0 0 64 30\" fill=\"none\" class=\"type-mobile_btn-arrow\"><path d=\"M39.0741 20.3031C39.2994 20.1435 39.3528 19.8311 39.1932 19.6058L33.7479 11.9193C33.6542 11.787 33.5019 11.7083 33.3397 11.7083C33.1775 11.7083 33.0252 11.787 32.9315 11.9193L27.4862 19.6058C27.3266 19.8311 27.38 20.1435 27.6053 20.3031C27.8306 20.4626 28.143 20.4092 28.3026 20.1839L33.3397 13.0746L38.3768 20.1839C38.5364 20.4092 38.8487 20.4626 39.0741 20.3031Z\" fill=\"#151515\"></path></svg></button></div><button data-floor-enter=\"\" type=\"button\" aria-label=\"Enter Floor\" class=\"type-mobile_enter-btn is--disabled\">ENTER FLOOR</button></div></section>"},"/cubes/double-height-villas":{"title":"Double-Height Villas (8 to 15) | Journalist House Tel Aviv","bodyClass":"","embeds":[{"c":"global-css w-embed","h":"<style>\n  :root {\n    --font-from: 10;\n    --font-to: 10;\n    --vw-from: calc(1920 / 100);\n    --vw-to: calc(2849 / 100);\n    --coefficient: calc((var(--font-to) - var(--font-from)) / (var(--vw-to) - var(--vw-from)));\n    --base: calc((var(--font-from) - var(--vw-from) * var(--coefficient)) / 16);\n  }\n\n  html {\n    font-size: calc(var(--base) * 1rem + var(--coefficient) * 1vw);\n  }\n\n  @media screen and (max-width: 1920px) {\n    :root {\n      --font-from: 6;\n      --font-to: 10;\n      --vw-from: calc(991 / 100);\n      --vw-to: calc(1920 / 100);\n    }\n  }\n\n  @media screen and (max-width: 991px) {\n    :root {\n      --font-from: 10;\n      --font-to: 10;\n      --vw-from: calc(1 / 100);\n      --vw-to: calc(991 / 100);\n    }\n  }\n  @media screen and (min-width: 992px) {\n    .chapter-tile:hover .chapter-link-arrow {\n      transform: translate(0rem, 0px);\n    }\n  }\n</style>\n\n<style>\n  /* Remove gray tap highlight on iOS */\n  a,\n  button,\n  input,\n  textarea,\n  .contact-us_x-wrapper {\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  a,\n  button {\n    outline: 0;\n  }\n\n  /* Make text look crisper and more legible in all browsers */\n  body {\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n    font-smoothing: antialiased;\n  }\n\n  html.lenis,\n  html.lenis body {\n    height: auto;\n  }\n  .lenis.lenis-smooth {\n    scroll-behavior: auto !important;\n  }\n  .lenis.lenis-smooth [data-lenis-prevent] {\n    overscroll-behavior: contain;\n  }\n  .lenis.lenis-stopped {\n    overflow: hidden;\n  }\n  .lenis.lenis-smooth iframe {\n    pointer-events: none;\n  }\n  html.is-preloading {\n    overflow: hidden;\n  }\n</style>\n<style>\n  .wf-design-mode .loader {\n    display: none;\n  }\n  /* Add auto overflow in webflow to make editing easier */\n  .wf-design-mode [data-horizontal-scroll-wrap] {\n    overflow: auto;\n  }\n  [data-load-reset] {\n    opacity: 0;\n  }\n\n  .chapter-tile__thumb-wrapper:hover .chapter-tile__thumb {\n    transform: scale(1.05);\n  }\n\n  /* .chapter-tile:hover .chapter-link-arrow {\n    transform: translate(0rem, 0px);\n  } */\n  .chapter-tile:hover .chapter-link-hovered {\n    opacity: 1;\n  }\n</style>\n\n<style>\n  /* Chapter menu — always legible on any background.\n   White ink + difference blend = the menu paints as the inverse of whatever is\n   behind it, so it stays visible over any colour or full-bleed image. */\n  .chapter-menu-c {\n    mix-blend-mode: difference;\n    background-color: transparent; /* any solid bg here would blend and kill the effect */\n  }\n  /* Ink must be white so 'difference' inverts the backdrop into a contrasting colour. */\n  .chapter-menu-c {\n    color: #fff;\n  } /* label text */\n  .chapter-menu-c .chapter-track {\n    background-color: rgba(255, 255, 255, 0.35);\n  } /* faint line */\n  .chapter-menu-c .chapter-track-fake {\n    background-color: rgba(255, 255, 255, 0.35);\n  } /* faint line */\n\n  .chapter-menu-c .chapter-track-fake.is--journy-2 {\n    background-color: #fff;\n  } /* faint line */\n  .chapter-menu-c .chapter-fill {\n    background-color: #fff;\n  } /* progress fill */\n\n  /* Scroll-lock while the Inquire modal is open (Lenis is stopped; this kills native fallback scroll) */\n  html.is-inquire-open {\n    overflow: hidden;\n    scrollbar-gutter: stable;\n  }\n  /* Modal hidden until JS takes over */\n  [mt-el='inquire-modal'] {\n    display: none;\n  }\n\n  #language-bar,\n  .enable-bottomlinks-feedback,\n  .enable-toolbar-links-section.enable-toolbar-link-powered-by,\n  .keyboard-shorcut {\n    display: none !important;\n  }\n</style>\n\n<!-- Mobile Sliders thumbs and scrollbars -->\n<style>\n  @media (max-width: 991px) {\n    [data-scrollbar] {\n      overflow-x: auto;\n      overflow-y: hidden;\n      scrollbar-width: none;\n    }\n    [data-scrollbar]::-webkit-scrollbar {\n      display: none;\n    }\n    [data-scrollbar] > * {\n      flex-shrink: 0;\n    }\n  }\n\n  /* Override per slider by setting these variables on the slider's parent */\n  [data-scrollbar-track] {\n    position: relative;\n    width: var(--scrollbar-track-width, calc(100% - 4rem));\n    height: 3px;\n    margin: var(--scrollbar-gap, 24px) auto 0;\n  }\n  [data-scrollbar-track]::before {\n    content: '';\n    position: absolute;\n    left: 0;\n    right: 0;\n    top: 1px;\n    height: 1px;\n    background: #ddd8d7;\n  }\n  [data-scrollbar-thumb] {\n    position: relative;\n    width: 40px;\n    height: 100%;\n    background: #000;\n    touch-action: none;\n  }\n\n  @media (min-width: 992px) {\n    [data-scrollbar-track] {\n      display: none;\n    }\n  }\n</style>"},{"c":"page-styles w-embed","h":"<style>\n  /* positioning context for the out-of-flow sub-line */\n  .the-building_hovered-text {\n    position: relative;\n  }\n\n  .unit-status {\n    position: absolute;\n    left: 0; /* align to the UNIT / number left edge */\n    top: 90%; /* below the label, no added height */\n    margin-top: 0.25em;\n    font-size: 0.55em; /* smaller than the unit number */\n    letter-spacing: normal; /* was 0.06em → too wide */\n    text-transform: uppercase;\n    text-align: left;\n    white-space: nowrap;\n    opacity: 0.65;\n  }\n  .cube-hover-wrap:has([data-floor-hover]:hover) .cube-img {\n    opacity: 0.3;\n  }\n  /* Cube 16 to 19 */\n  .cube-hover-wrap:has([data-floor-hover='floor-19']:hover) [data-floor='floor-19'] {\n    opacity: 1;\n  }\n  .cube-hover-wrap:has([data-floor-hover='floor-18']:hover) [data-floor='floor-18'] {\n    opacity: 1;\n  }\n  .cube-hover-wrap:has([data-floor-hover='floor-17']:hover) [data-floor='floor-17'] {\n    opacity: 1;\n  }\n  .cube-hover-wrap:has([data-floor-hover='floor-16']:hover) [data-floor='floor-16'] {\n    opacity: 1;\n  }\n  /* Cube 16 to 19 */\n\n  /* Cube 8 to 15 */\n  .cube-hover-wrap:has([data-floor-hover='floor-15']:hover) [data-floor='floor-15'] {\n    opacity: 1;\n  }\n  .cube-hover-wrap:has([data-floor-hover='floor-14']:hover) [data-floor='floor-14'] {\n    opacity: 1;\n  }\n  .cube-hover-wrap:has([data-floor-hover='floor-13']:hover) [data-floor='floor-13'] {\n    opacity: 1;\n  }\n  .cube-hover-wrap:has([data-floor-hover='floor-12']:hover) [data-floor='floor-12'] {\n    opacity: 1;\n  }\n  .cube-hover-wrap:has([data-floor-hover='floor-11']:hover) [data-floor='floor-11'] {\n    opacity: 1;\n  }\n  .cube-hover-wrap:has([data-floor-hover='floor-10']:hover) [data-floor='floor-10'] {\n    opacity: 1;\n  }\n  .cube-hover-wrap:has([data-floor-hover='floor-9']:hover) [data-floor='floor-9'] {\n    opacity: 1;\n  }\n  .cube-hover-wrap:has([data-floor-hover='floor-8']:hover) [data-floor='floor-8'] {\n    opacity: 1;\n  }\n  /* Cube 8 to 15 */\n\n  /* Cube 6 to 7 */\n  .cube-hover-wrap:has([data-floor-hover='floor-7']:hover) [data-floor='floor-7'] {\n    opacity: 1;\n  }\n  .cube-hover-wrap:has([data-floor-hover='floor-6']:hover) [data-floor='floor-6'] {\n    opacity: 1;\n  }\n  /* Cube 6 to 7 */\n</style>\n<style>\n  /*MOBILE  */\n  .type-mobile_floor-level-txt {\n    opacity: 0;\n    visibility: hidden;\n  }\n</style>"},{"c":"navbar-size-shrink-code w-embed","h":"<style>\n  @media (min-width: 992px) {\n    .chapter-tile__thumb-wrapper {\n      aspect-ratio: 277 / 291;\n      min-height: 0;\n      max-height: 100%;\n      overflow: hidden;\n    }\n\n    .chapter-tile__thumb {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      display: block;\n    }\n\n    .chapter-tile {\n      min-height: 0;\n      display: flex;\n      flex-direction: column;\n    }\n\n    .chapter-bottom_wrap {\n      flex: 0 0 auto;\n    }\n\n    .chapter-menu__grid {\n      flex: 0 1 auto;\n      min-height: 0;\n      align-content: center;\n    }\n  }\n</style>"},{"c":"hamburger_embed w-embed","h":"<style>\n  @media (min-width: 992px) {\n    .hamburger_5_wrap {\n      --thickness: 0.2rem;\n      --gap: 1rem;\n      --rotate: 35;\n      --width: 100%;\n    }\n    .w--open .hamburger_5_line {\n      transform: scaleX(0);\n    }\n    .w--open .hamburger_5_line:first-child {\n      transform: translateY(calc(var(--thickness) + var(--gap))) rotate(calc(var(--rotate) * -1deg));\n    }\n    .w--open .hamburger_5_line:last-child {\n      transform: translateY(calc(var(--thickness) * -1 + var(--gap) * -1)) rotate(calc(var(--rotate) * 1deg));\n    }\n  }\n\n    @media (max-width: 991px) {\n    .hamburger_5_wrap {\n      --thickness: 0.1rem;\n      --gap: 0.5rem;\n      --rotate: 45;\n      --width: 100%;\n    }\n    .w--open .hamburger_5_line {\n      transform: scaleX(0);\n    }\n    .w--open .hamburger_5_line:first-child {\n      transform: translateY(calc(var(--thickness) + var(--gap))) rotate(calc(var(--rotate) * -1deg));\n    }\n    .w--open .hamburger_5_line:last-child {\n      transform: translateY(calc(var(--thickness) * -1 + var(--gap) * -1)) rotate(calc(var(--rotate) * 1deg));\n    }\n  }\n</style>"}],"scripts":["https://jurnalist-house-2026.vercel.app/pages/cubes.js"],"inline":["\n  // Hebrew locale (/he, dir=\"rtl\") loads the Hebrew build; every other page loads English.\n  document.write('<script defer src=\"https://jurnalist-house-2026.vercel.app/' + (document.documentElement.dir === \"rtl\" ? \"he/\" : \"\") + 'global.js\"><\\/script>');\n"],"main":"<section class=\"section_plans-hero\"><a href=\"/select-a-residence\" class=\"back-btn w-inline-block\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"11\" height=\"16\" vi